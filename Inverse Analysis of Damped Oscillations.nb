Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindFit", "[", 
  RowBox[{"data1", ",", 
   RowBox[{"A", "*", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"t", " ", "\[Gamma]"}], "2"]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", "t", " ", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[Gamma]", "2"], "-", 
          RowBox[{"4", " ", "\[Omega]"}]}]]}], "]"}], "+", 
      FractionBox[
       RowBox[{"\[Gamma]", " ", 
        RowBox[{"Sinh", "[", 
         RowBox[{
          FractionBox["1", "2"], " ", "t", " ", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["\[Gamma]", "2"], "-", 
            RowBox[{"4", " ", "\[Omega]"}]}]]}], "]"}]}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["\[Gamma]", "2"], "-", 
         RowBox[{"4", " ", "\[Omega]"}]}]]]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"A", ",", "\[Gamma]", ",", "\[Omega]"}], "}"}], ",", "t"}], 
  "]"}]], "Input",
